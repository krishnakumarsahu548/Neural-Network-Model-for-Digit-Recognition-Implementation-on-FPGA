import os
import zipfile
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torchvision import datasets, transforms
import numpy as np

# Google Colab specific import
try:
    from google.colab import files
    IN_COLAB = True
except ImportError:
    IN_COLAB = False

# GPU Check
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"1. Training Device: {device.type.upper()} (GPU use karenge toh fast hoga!)")

# Pad(2) se 28x28 image 32x32 ban jayegi
transform = transforms.Compose([transforms.Pad(2), transforms.ToTensor()])
train_dataset = datasets.MNIST(root='./data', train=True, download=True, transform=transform)
test_dataset = datasets.MNIST(root='./data', train=False, download=True, transform=transform)
train_loader = torch.utils.data.DataLoader(train_dataset, batch_size=64, shuffle=True)

# ==========================================
# 2. CNN MODEL DEFINITION
# ==========================================
class FPGA_CNN(nn.Module):
    def __init__(self):
        super(FPGA_CNN, self).__init__()
        self.conv1 = nn.Conv2d(1, 6, kernel_size=5)
        self.conv2 = nn.Conv2d(6, 16, kernel_size=5)
        self.fc1 = nn.Linear(400, 16)
        self.fc2 = nn.Linear(16, 16)
        self.fc3 = nn.Linear(16, 10)

    def forward(self, x):
        x = F.relu(self.conv1(x))
        x = F.max_pool2d(x, 2)
        x = F.relu(self.conv2(x))
        x = F.max_pool2d(x, 2)
        x = x.view(x.size(0), -1) # Flatten
        x = F.relu(self.fc1(x))
        x = F.relu(self.fc2(x))
        x = self.fc3(x)
        return x

model = FPGA_CNN().to(device)

# ==========================================
# 3. TRAINING FOR 25 EPOCHS
# ==========================================
EPOCHS = 25
print(f"2. Model Train ho raha hai ({EPOCHS} Epochs)...")
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

for epoch in range(1, EPOCHS + 1):
    model.train()
    total_loss = 0
    correct = 0
    for batch_idx, (data, target) in enumerate(train_loader):
        data, target = data.to(device), target.to(device)

        optimizer.zero_grad()
        output = model(data)
        loss = criterion(output, target)
        loss.backward()
        optimizer.step()

        total_loss += loss.item()
        pred = output.argmax(dim=1, keepdim=True)
        correct += pred.eq(target.view_as(pred)).sum().item()

    accuracy = 100. * correct / len(train_loader.dataset)
    print(f"   Epoch {epoch}/{EPOCHS} -> Loss: {total_loss/len(train_loader):.4f} | Accuracy: {accuracy:.2f}%")

print("\nTraining Complete! Model ko wapas CPU par laa rahe hain...\n")
model.to('cpu')

# ==========================================
# 4. HELPER FUNCTIONS FOR Q8.8 HEX
# ==========================================
def float_to_q88_hex(val):
    val = float(val) # Tensor to normal float
    v = int(round(val * 256.0))
    v = max(-32768, min(32767, v))
    if v < 0: v = (1 << 16) + v
    return f"{v:04x}"

def save_coe(filename, data_array):
    with open(filename, 'w') as f:
        f.write("memory_initialization_radix=16;\n")
        f.write("memory_initialization_vector=\n")
        flat_data = data_array.flatten()
        for i, val in enumerate(flat_data):
            hex_val = float_to_q88_hex(val)
            if i == len(flat_data) - 1:
                f.write(f"{hex_val};\n")
            else:
                f.write(f"{hex_val},\n")

os.makedirs("fpga_export", exist_ok=True)

# ==========================================
# 5. EXPORTING WEIGHTS & BIASES
# ==========================================
print("3. Weights aur Biases (.coe) generate ho rahe hain...")

save_coe("fpga_export/conv1_weight.coe", model.conv1.weight.detach().numpy())
save_coe("fpga_export/conv1_bias.coe", model.conv1.bias.detach().numpy())

# ---> BUG FIXED: Direct PyTorch shape for Conv2! <---
save_coe("fpga_export/conv2_weight.coe", model.conv2.weight.detach().numpy())
save_coe("fpga_export/conv2_bias.coe", model.conv2.bias.detach().numpy())

# FC1 still needs reshape because of 2D to 1D flattening transition
w3 = model.fc1.weight.detach().numpy()
w3_3d = w3.reshape(16, 16, 5, 5)
w3_hw = np.transpose(w3_3d, (0, 2, 3, 1)).reshape(16, 400)
save_coe("fpga_export/fc1_weight_rearranged.coe", w3_hw)
save_coe("fpga_export/fc1_bias.coe", model.fc1.bias.detach().numpy())

save_coe("fpga_export/fc2_weight.coe", model.fc2.weight.detach().numpy())
save_coe("fpga_export/fc2_bias.coe", model.fc2.bias.detach().numpy())
save_coe("fpga_export/fc3_weight.coe", model.fc3.weight.detach().numpy())
save_coe("fpga_export/fc3_bias.coe", model.fc3.bias.detach().numpy())

# ==========================================
# 6. FINDING DIGITS 0-9 & EXPORTING IMAGES
# ==========================================
print("4. Digit 0 se 9 tak ki Images .coe me save ho rahi hain...")
digit_images = {}
for data, target in test_dataset:
    label = target # <--- BUG FIXED HERE!
    if label not in digit_images:
        digit_images[label] = data
    if len(digit_images) == 10:
        break

for digit in range(10):
    img_data = digit_images[digit].detach().numpy()
    save_coe(f"fpga_export/img_digit_{digit}.coe", img_data)

# ==========================================
# 7. DIGIT 6 VERIFICATION DATA EXTRACTION
# ==========================================
print("5. Digit 6 ka Verification Data ban raha hai...")
digit_6_img = digit_images[6].unsqueeze(0)

with open("fpga_export/verification_digit_6.txt", "w") as f:
    f.write("========== DIGIT 6 LAYER-BY-LAYER VERIFICATION (Q8.8 HEX) ==========\n\n")
    model.eval()
    with torch.no_grad():
        x = digit_6_img
        x = F.relu(model.conv1(x))
        f.write("[LAYER] Conv1 Output (After ReLU):\n")
        f.write(f"Channel 0, Pehle 10 Pixels: {[float_to_q88_hex(v) for v in x[0, 0].flatten()[:10]]}\n\n")

        x = F.max_pool2d(x, 2)
        f.write("[LAYER] Pool1 Output:\n")
        f.write(f"Channel 0, Pehle 10 Pixels: {[float_to_q88_hex(v) for v in x[0, 0].flatten()[:10]]}\n\n")

        x = F.relu(model.conv2(x))
        f.write("[LAYER] Conv2 Output (After ReLU):\n")
        f.write(f"Channel 0, Pehle 10 Pixels: {[float_to_q88_hex(v) for v in x[0, 0].flatten()[:10]]}\n\n")

        x = F.max_pool2d(x, 2)
        hw_pool2 = x[0].permute(1, 2, 0).flatten()
        f.write("[LAYER] Pool2 Flattened (FC1 me jaane wala data):\n")
        f.write(f"Pehle 16 Pixels (Px0_Ch0 se Px0_Ch15): {[float_to_q88_hex(v) for v in hw_pool2[:16]]}\n\n")

        x = x.view(x.size(0), -1)
        x = F.relu(model.fc1(x))
        f.write("[LAYER] FC1 Output (After ReLU):\n")
        f.write(f"Sabhi 16 Neurons: {[float_to_q88_hex(v) for v in x[0]]}\n\n")

        x = F.relu(model.fc2(x))
        f.write("[LAYER] FC2 Output (After ReLU):\n")
        f.write(f"Sabhi 16 Neurons: {[float_to_q88_hex(v) for v in x[0]]}\n\n")

        x = model.fc3(x)
        f.write("[LAYER] FC3 Output (FINAL LOGITS):\n")
        f.write(f"Sabhi 10 Neurons (0 se 9 tak): {[float_to_q88_hex(v) for v in x[0]]}\n\n")

        pred = x.argmax(dim=1, keepdim=True).item()
        f.write(f">>> EXPECTED DIGIT PREDICTION : {pred} <<<\n")

# ==========================================
# 8. ZIP EVERYTHING AND DOWNLOAD
# ==========================================
print("6. ZIP file ban rahi hai...")
zip_filename = 'cnn_fpga_25epochs_pack.zip'
with zipfile.ZipFile(zip_filename, 'w') as zipf:
    for root, dirs, files_list in os.walk("fpga_export"):
        for file in files_list:
            zipf.write(os.path.join(root, file), file)

print(f"\nSUCCESS! '{zip_filename}' is ready.")

if IN_COLAB:
